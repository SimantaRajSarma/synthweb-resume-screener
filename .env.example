# Active AI provider: "claude" (default) or "gemini"
AI_PROVIDER=claude

# Anthropic Claude Configuration (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Google Gemini Configuration (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Hourly Rate Limit (protects API credits in production)
RATE_LIMIT_MAX_PER_HOUR=10
